enum StakingPoolStatus {
  OPEN
  FULL
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StakingPoolType {
  HEAD_TO_HEAD
  TRIPLE_THREAT
}

model StakingPool {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
