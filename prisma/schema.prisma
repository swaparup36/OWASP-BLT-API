// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE USER & AUTH MODELS
// ============================================

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique @db.VarChar(150)
  email       String    @unique @db.VarChar(254)
  firstName   String?   @map("first_name") @db.VarChar(150)
  lastName    String?   @map("last_name") @db.VarChar(150)
  password    String    @db.VarChar(128)
  isActive    Boolean   @default(true) @map("is_active")
  isStaff     Boolean   @default(false) @map("is_staff")
  isSuperuser Boolean   @default(false) @map("is_superuser")
  dateJoined  DateTime  @default(now()) @map("date_joined")
  lastLogin   DateTime? @map("last_login")

  // Relations
  token                    Token?
  wallet                   Wallet?
  userProfile              UserProfile?
  userSubscribedUsers   UserProfile[] @relation("SubscribedUsersRelation")
  adminOrganizations       Organization[]           @relation("AdminOrganizations")
  managerOrganizations     Organization[]           @relation("ManagerOrganizations")
  userDomains              Domain[]                 @relation("DomainManagers")
  issues                   Issue[]                  @relation("IssueCreator")
  assignedIssues           Issue[]                  @relation("IssueAssignedUser")
  issueScreenshots         IssueScreenshot[]
  issueTeamMembers         Issue[] @relation("IssueTeamMembers")
  closedIssues             Issue[] @relation("IssueClosedBy")
  points                   Points[]
  userInvites              Invite[]                 @relation("InvitingUser")
  invitedBy                Invite[]                 @relation("InvitedUser")
  ipReports                IP[]                     @relation("IPReporter")
  activities               Activity[]
  bids                     Bid[]
  winners                 Winner[]                 @relation("WinnerUser")
  runners                 Winner[]                 @relation("RunnerUser")
  secondRunners           Winner[]                 @relation("SecondRunnerUser")
  monitoredDomains         Monitor[]
  userInviteFriends        InviteFriend[]
  receivedInvites          InviteFriend[] @relation("InviteRecipients")
  userProjectMembers       CompanyProjectMember[]
  projectContributions     ProjectContribution[]
  baconEarnings            BaconEarning?
  bountyClaims             BountyClaim[]
  projects                 ProjectMember[]
  contributedProjects      Contribution[]
  organizationMembers      OrganizationMember[]
  organizationAdmins OrganizationAdmin[] 
  receivedTimeOffRequests  TimeOffRequest[]         @relation("ApprovedByUser")
  submittedTimeOffRequests TimeOffRequest[]         @relation("SubmittedByUser")
  rewardTransactions       RewardTransaction[]
  userCheckIns             UserCheckIn[]
  checkInNotes             CheckInNote[]
  projectBoards            ProjectBoard[]           @relation("ProjectBoardCreator")
  assignedTasks            Task[]                   @relation("AssignedToUser")
  createdTasks             Task[]                   @relation("CreatedByUser")
  taskComments             TaskComment[]
  githubIssues             GithubIssue[]
  followingOrganizations   UserFollowOrganization[]
  wonStakingPools          StakingPool[]
  stakingEntries           StakingEntry[]
  stakingTransactions      StakingTransaction[]
  joinRequests             JoinRequest[]
  forumPosts               ForumPost[]
  forumVotes               ForumVote[]
  forumComments            ForumComment[]
  baconTokens              BaconToken[]
  timeLogs                 TimeLog[]               @relation("UserTimeLogs")
  activityLogs             ActivityLog[]
  dailyStatusReports       DailyStatusReport[]
  ipReport                 IpReport[]
  likedActivities Activity[] @relation("ActivityLikes")
  dislikedActivities Activity[] @relation("ActivityDislikes")
  userBadges               UserBadge[] @relation("badgeOwnerUser")
  badgesAwarded   UserBadge[] @relation("UserBadgeAwardedBy")
  posts                   Post[]
  userChallenges Challenge[] @relation("ChallengeParticipants")
  rooms Room[] @relation("RoomUsers")
  adminRooms Room[] @relation("RoomAdmin")
  kudosSent Kudos[] @relation("KudosSender")
  kudosReceived Kudos[] @relation("KudosReciever")
  instructorOfCourses Course[] @relation("CourseInstructor")
  instructorOfLectures Lecture[] @relation("LectureInstructor")
  studentOfLectureStats LectureStatus[] @relation("LectureStatusStudent")
  enrollments Enrollment[] @relation("EnrollmentStudent")
  ratings Rating[]
  beaconSubmissions BaconSubmission[]
  threads Thread[] @relation("ThreadParticipants")
  messages Message[]
  userTaskProgress UserTaskProgress[]
  userLabProgress UserLabProgress[]
  notifications Notification[]
  reminderSettings ReminderSettings[]
  stakingPoolsCreated StakingPool[] @relation("StakingPoolCreator")

  @@map("auth_user")
}

model Token {
  key     String   @id @db.VarChar(40)
  created DateTime @default(now())
  userId  Int      @unique @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authtoken_token")
}

enum BadgeType {
  AUTOMATIC
  MANUAL
}

model Badge {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  description String?   @db.Text
  icon      String?   @db.VarChar(255)
  type       BadgeType @default(MANUAL)
  criteria   String?   @db.Text
  created    DateTime  @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  badgeId  Int      @map("badge_id")
  awardedById Int?     @map("awarded_by_id")
  awardedAt DateTime @default(now()) @map("awarded_at")
  reason  String?   @db.Text

  user     User     @relation("badgeOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy  User?     @relation("UserBadgeAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
}

// ============================================
// SUBSCRIPTION & ORGANIZATION MODELS
// ============================================

model Subscription {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(25)
  chargePerMonth  Int      @map("charge_per_month")
  huntPerDomain   Int      @map("hunt_per_domain")
  numberOfDomains Int      @map("number_of_domains")
  feature         Boolean  @default(true)
  created         DateTime @default(now())

  organizations Organization[]

  @@map("subscription")
}

model Tag {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(255)
  slug    String   @unique
  created DateTime @default(now())

  organizations Organization[]
  domains       Domain[]       @relation("DomainTags")
  issues Issue[] @relation("IssueTags")
  userProfiles UserProfile[] @relation("UserTags")
  repos Repo[] @relation("RepoTags")
  osshCommunities OsshCommunity[] @relation("OsshCommunityTags")
  osshDiscussionChannels OsshDiscussionChannel[] @relation("OsshDiscussionChannelTags")
  osshArticles OsshArticle[] @relation("OsshArticleTags")
  courses Course[] @relation("CourseTags")
  lectures Lecture[] @relation("LectureTags")

  @@map("tag")
}

// ============================================
// INTEGRATION MODELS
// ============================================

enum IntegrationService {
  SLACK
}

model Integration {
  id             Int                 @id @default(autoincrement())
  serviceName    IntegrationService? @map("service_name")
  organizationId Int                 @map("organization_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slackIntegration    SlackIntegration?
  linkedOrganizations Organization[]    @relation("OrganizationIntegrations")

  @@map("integration")
}

model SlackIntegration {
  id                 Int     @id @default(autoincrement())
  integrationId      Int     @unique @map("integration_id")
  botAccessToken     String? @map("bot_access_token") @db.VarChar(255)
  workspaceName      String? @map("workspace_name") @db.VarChar(255)
  defaultChannelName String? @map("default_channel_name") @db.VarChar(255)
  defaultChannelId   String? @map("default_channel_id") @db.VarChar(255)
  dailyUpdates       Boolean @default(false) @map("daily_updates")
  dailyUpdateTime    Int?    @map("daily_update_time")
  welcomeMessage     String? @map("welcome_message") @db.Text

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("slack_integration")
}

enum SlackBotActivityType {
  TEAM_JOIN
  SLASH_COMMAND
  MESSAGE
  ERROR
}

model SlackBotActivity {
  id               Int                 @id @default(autoincrement())
  workspaceId      String              @map("workspace_id") @db.VarChar(20)
  workspaceName    String?              @map("workspace_name") @db.VarChar(255)
  activityType    SlackBotActivityType @map("activity_type")
  userId          String?              @map("user_id") @db.VarChar(20)
  details         Json @default("{}")
  success         Boolean             @default(true)
  errorMessage    String?             @map("error_message") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
}

// ============================================
// ORGANIZATION MODEL
// ============================================

enum OrganizationType {
  ORGANIZATION
  INDIVIDUAL
  TEAM
}

model Organization {
  id                     Int              @id @default(autoincrement())
  adminId                Int?             @map("admin_id")
  name                   String           @db.VarChar(255)
  slug                   String           @unique @db.VarChar(255)
  description            String?          @db.VarChar(500)
  logo                   String?          @db.VarChar(100)
  url                    String           @unique
  email                  String?          @db.VarChar(254)
  twitter                String?
  matrixUrl              String?          @map("matrix_url")
  slackUrl               String?          @map("slack_url")
  discordUrl             String?          @map("discord_url")
  gitterUrl              String?          @map("gitter_url")
  zulipchatUrl           String?          @map("zulipchat_url")
  elementUrl             String?          @map("element_url")
  facebook               String?
  created                DateTime         @default(now())
  modified               DateTime         @updatedAt
  subscriptionId         Int?             @map("subscription_id")
  isActive               Boolean          @default(false) @map("is_active")
  trademarkCount         Int              @default(0) @map("trademark_count")
  trademarkCheckDate     DateTime?        @map("trademark_check_date")
  teamPoints             Int              @default(0) @map("team_points")
  tagline                String?          @db.VarChar(255)
  license                String?          @db.VarChar(100)
  categories             Json             @default("[]")
  contributorGuidanceUrl String?          @map("contributor_guidance_url")
  techTags               Json             @default("[]") @map("tech_tags")
  topicTags              Json             @default("[]") @map("topic_tags")
  sourceCode             String?          @map("source_code")
  ideasLink              String?          @map("ideas_link")
  reposUpdatedAt         DateTime?        @map("repos_updated_at")
  type                   OrganizationType @default(ORGANIZATION)
  checkInsEnabled        Boolean          @default(false) @map("check_ins_enabled")

  // Address fields
  addressLine1 String? @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String? @db.VarChar(100)
  postalCode   String? @map("postal_code") @db.VarChar(20)

  // Geographical coordinates
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  // GitHub and GSOC fields
  githubOrg   String? @map("github_org") @db.VarChar(255)
  gsocYear    Int?    @map("gsoc_year")
  gsocProfile String? @map("gsoc_profile")

  // Additional Info
  additionalInfo String? @map("additional_info") @db.Text

  // Relations
  admin                    User?                    @relation("AdminOrganizations", fields: [adminId], references: [id], onDelete: Cascade)
  managers                 User[]                   @relation("ManagerOrganizations")
  subscription             Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tags                     Tag[]
  integrations             Integration[]            @relation("OrganizationIntegrations")
  organizationIntegrations Integration[]
  domains                  Domain[]
  organizationMembers      OrganizationMember[]
  admins OrganizationAdmin[] 
  rewardTransactions       RewardTransaction[]
  companyAdmins            CompanyAdmin[]
  githubRepos              Repo[]
  followers                UserFollowOrganization[]
  joinRequests             JoinRequest[]
  trademarks               Trademark[]
  userProfiles UserProfile[] @relation("OrganizationUserProfiles")
  projects                 Project[]
  teamChallenges Challenge[] @relation("ChallengeTeamParticipants")
  hackathons Hackathon[]
  hackathonSponsors HackathonSponsor[]
  timeLogs                 TimeLog[]

  @@map("organization")
}

model JoinRequest {
  id         Int      @id @default(autoincrement())
  teamId     Int      @map("team_id")
  userId     Int      @map("user_id")
  craetedAt  DateTime @default(now()) @map("created_at")
  isAccepted Boolean  @default(false) @map("is_accepted")

  team Organization @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// DOMAIN & BUG TRACKING MODELS
// ============================================

model Domain {
  id                   Int       @id @default(autoincrement())
  organizationId       Int?      @map("organization_id")
  name                 String    @unique @db.VarChar(255)
  url                  String
  logo                 String?   @db.VarChar(100)
  webshot              String?   @db.VarChar(100)
  clicks               Int?
  emailEvent           String?   @default("") @map("email_event") @db.VarChar(255)
  color                String?   @db.VarChar(10)
  github               String?   @db.VarChar(255)
  email                String?   @db.VarChar(254)
  twitter              String?   @db.VarChar(30)
  facebook             String?
  created              DateTime  @default(now())
  modified             DateTime  @updatedAt
  isActive             Boolean   @default(true) @map("is_active")
  hasSecurityTxt       Boolean   @default(false) @map("has_security_txt")
  securityTxtCheckedAt DateTime? @map("security_txt_checked_at")

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managers     User[]        @relation("DomainManagers")
  issues       Issue[]
  hunts        Hunt[]
  tags         Tag[]         @relation("DomainTags")
  userSubscribedDomains UserProfile[] @relation("UserSubscribedDomains")
  organizationAdmins OrganizationAdmin[]

  @@index([organizationId], map: "domain_org_idx")
  @@map("domain")
}

model Hunt {
  id          Int       @id @default(autoincrement())
  domainId    Int       @map("domain_id")
  name        String    @db.VarChar(255)
  description String    @db.Text
  url         String
  prize       Int       @default(0)
  prizeWinner Decimal   @default(0) @db.Decimal(6, 2) @map("prize_winner")
  prizeRunner Decimal   @default(0) @db.Decimal(6, 2) @map("prize_runner")
  prizeSecondRunner Decimal   @default(0) @db.Decimal(6, 2) @map("prize_second_runner")
  logo        String?   @db.VarChar(255)
  banner        String?   @db.VarChar(255)
  plan        String?   @db.VarChar(10)
  txnId       String?   @map("txn_id") @db.VarChar(50)
  created     DateTime  @default(now())
  startsOn      DateTime  @map("starts_on")
  endOn     DateTime? @map("end_on")
  isPublished Boolean   @default(false) @map("is_published")
  resultPublished Boolean   @default(false) @map("result_published")
  modified    DateTime  @updatedAt
  prizes HuntPrize[]
  winners     Winner[]

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("hunt")
}

model HuntPrize {
  id                        Int       @id @default(autoincrement())
  huntId                    Int
  name                      String    @db.VarChar(50)
  value                     Int       @default(0)
  no_of_eligible_projects   Int       @default(1)
  valid_submissions_eligible Boolean  @default(false)
  prize_in_crypto           Boolean   @default(false)
  description               String?   @db.Text
  created                   DateTime  @default(now())

  hunt                      Hunt      @relation(fields: [huntId], references: [id])
}

// ===========================================
// TRADEMARK MODELS
// ===========================================

model TrademarkOwner {
  name                 String  @id @db.VarChar(255)
  address1             String? @db.VarChar(255)
  address2             String? @db.VarChar(255)
  city                 String? @db.VarChar(100)
  state                String? @db.VarChar(100)
  country              String? @db.VarChar(100)
  postalCode           String? @map("postcode") @db.VarChar(20)
  ownerType            String? @map("owner_type") @db.VarChar(20)
  ownerLabel           String? @map("owner_label") @db.VarChar(100)
  legalEntityType      String? @map("legal_entity_type") @db.VarChar(20)
  legalEntityTypeLabel String? @map("legal_entity_type_label") @db.VarChar(100)

  trademarks           Trademark[]
}

model Trademark {
  id                Int       @id @default(autoincrement())
  keyword           String   @db.VarChar(255)
  registrationNumber String? @map("registration_number") @db.VarChar(50)
  serialNumber      String?  @map("serial_number") @db.VarChar(50)
  statusLabel       String?  @map("status_label") @db.VarChar(50)
  statusCode        String?  @map("status_code") @db.VarChar(20)
  statusDate        DateTime? @map("status_date")
  statusDefinition  String?  @map("status_definition") @db.VarChar(255)
  filingDate        DateTime? @map("filing_date")
  registrationDate  DateTime? @map("registration_date")
  abandonmentDate   DateTime? @map("abandonment_date")
  expirationDate    DateTime? @map("expiration_date")
  description       String?  @db.Text
  organizationId    Int?     @map("organization_id")

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owners        TrademarkOwner[]
}

// ============================================
// ISSUE MODEL
// ============================================

enum IssueLabel {
  GENERAL
  NUMBER_ERROR
  FUNCTIONAL
  PERFORMANCE
  SECURITY
  TYPO
  DESIGN
  SERVER_DOWN
  TRADEMARK_SQUATTING
}

model Issue {
  id                   Int       @id @default(autoincrement())
  userId               Int?       @map("user_id")
  teamMembers         User[]     @relation("IssueTeamMembers")
  url                  String
  description          String    @db.Text
  markdownDescription String?   @map("markdown_description") @db.Text
  label                IssueLabel @default(GENERAL)
  views                Int       @default(0)
  verified             Boolean   @default(false)
  score                Int       @default(0)
  status               String?    @default("open") @db.VarChar(10)
  userAgent           String?   @db.VarChar(255) @map("user_agent")
  ocr                  String?   @db.Text
  screenshot           String?   @db.VarChar(500)
  closedById           Int? @map("closed_by_id")
  closedDate          DateTime? @map("closed_date")
  githubUrl            String?   @map("github_url")
  created              DateTime  @default(now())
  modified             DateTime  @updatedAt
  domainId             Int?      @map("domain_id")
  isHidden             Boolean   @default(false) @map("is_hidden")
  rewarded             Int       @default(0)
  reporterIpAddress String?   @map("reporter_ip_address") @db.VarChar(50) // TODO ADD RELATION WITH `GenericIPAddressField` model
  cveId               String?   @map("cve_id") @db.VarChar(16)
  cveScore            Decimal?  @map("cve_score") @db.Decimal(2, 1)
  tags                Tag[] @relation("IssueTags")
  public               Boolean   @default(true)
  assignedId           Int?      @map("assigned_id")
  tokenValue           Int       @default(0) @map("token_value")

  // Relations
  user         User?              @relation("IssueCreator", fields: [userId], references: [id], onDelete: Cascade)
  domain       Domain?           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  assignedUser User?             @relation("IssueAssignedUser", fields: [assignedId], references: [id])
  closedBy    User?       @relation("IssueClosedBy", fields: [closedById], references: [id], onDelete: Cascade)
  screenshots  IssueScreenshot[]
  activities   Activity[]
  bids         Bid[]
  winners      Winner[]
  points      Points[]
  comments    IssueComments[]
  upvotedBy   UserProfile[]             @relation("IssueUpvotes")
  downvotedBy UserProfile[]             @relation("IssueDownvotes")
  savedBy     UserProfile[]             @relation("IssueSaved")
  flaggedBy   UserProfile[]             @relation("IssueFlagged")

  @@map("issue")
}

model IssueComments {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  issueId   Int?
  createdAt DateTime @default(now())

  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  @@map("issue_comments")
}

model IssueScreenshot {
  id      Int    @id @default(autoincrement())
  image   String @db.VarChar(500)
  issueId Int    @map("issue_id")
  userId  Int    @map("user_id")
  created DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("issue_screenshot")
}

// ============================================
// POINTS & REWARDS MODELS
// ============================================

model Points {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  issueId  Int      @map("issue_id")
  domainId Int?     @map("domain_id")
  score    Int
  created  DateTime @default(now())
  modified DateTime @updatedAt
  reason   String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("points")
}

model Winner {
  id         Int      @id @default(autoincrement())
  issueId   Int?     @map("issue_id")
  huntId     Int?     @map("hunt_id")
  winnerId   Int?      @map("winner_id")
  runnerId   Int?      @map("runner_id")
  secondRunnerId Int?      @map("second_runner_id")
  prizeDistributed    Boolean  @default(false) @map("prize_distributed")
  prize      Int      @default(0)
  prizeAmount     Decimal   @default(0) @db.Decimal(6, 2) @map("prize_amount")

  hunt  Hunt?  @relation(fields: [huntId], references: [id], onDelete: Cascade)
  winner  User?   @relation("WinnerUser", fields: [winnerId], references: [id], onDelete: Cascade)
  runner  User?   @relation("RunnerUser", fields: [runnerId], references: [id], onDelete: Cascade)
  secondRunner  User?   @relation("SecondRunnerUser", fields: [secondRunnerId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("winner")
}

// ============================================
// PAYMENT & WALLET MODELS
// ============================================

model Payment {
  id     Int     @id @default(autoincrement())
  walletId  Int
  value  Decimal @db.Decimal(6, 2)
  active Boolean @default(true)
  userId Int     @map("user_id")
  created DateTime @default(now())

  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model Wallet {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  accountId      String?   @map("account_id") @db.Text
  currentBalance Decimal  @default(0.00) @map("current_balance") @db.Decimal(6, 2)
  created        DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  payments Payment[]

  @@map("wallet")
}

// ============================================
// USER PROFILE MODELS
// ============================================

enum UserProfileTitle {
  UNRATED
  BRONZE
  SILVER
  GOLD
  PLATINUM
}


model UserProfile {
  id                   Int     @id @default(autoincrement())
  follows               UserProfile[] @relation("UserFollows")
  follower              UserProfile[] @relation("UserFollows")
  userId               Int     @unique @map("user_id")
  userAvatar           String? @map("user_avatar") @db.VarChar(1000)
  title                UserProfileTitle @default(UNRATED)
  role                 String?  @default("user") @db.VarChar(255)
  description          String? @db.Text
  winnings             Decimal? @db.Decimal(10, 2)
  issueUpvoted         Issue[] @relation("IssueUpvotes")
  issueDownvoted       Issue[] @relation("IssueDownvotes")
  issueSaved           Issue[] @relation("IssueSaved")
  issueFlagged         Issue[] @relation("IssueFlagged")
  issuesHidden         Boolean @default(false) @map("issues_hidden")

  // fields for visit tracking
  dailyVisitCount      Int     @default(0) @map("daily_visit_count")
  last_visit_day       DateTime? @map("last_visit_day")

  // SendGrid webhook fields
  emailStatus     String? @map("email_status") @db.VarChar(50)
  emailLastEvent  String? @map("email_last_event") @db.VarChar(50)
  emailLastEventTime DateTime? @map("email_last_event_time")
