  id Int @id @default(autoincrement())
  labId Int @map("lab_id")
  name String @db.VarChar(255)
  description String? @db.Text
  taskType TasksType @map("task_type")
  order Int
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  lab Labs @relation(fields: [labId], references: [id], onDelete: Cascade)
  content TaskContent? @relation("TaskContentRelation")
  userProgress UserTaskProgress[]
}

model TaskContent {
  id Int @id @default(autoincrement())
  taskId Int @unique @map("task_id")
  theoryContent String? @map("theory_content") @db.Text
  mcqQuestions String? @map("mcq_questions") @db.Text
  mcqOptions Json? @map("mcq_options") @db.Json
  correctAnswer String? @map("correct_answer") @db.VarChar(10)
  simulationConfig Json? @map("simulation_config") @db.Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  task   Tasks    @relation("TaskContentRelation", fields: [taskId], references: [id], onDelete: Cascade)
}

model UserTaskProgress {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  taskId Int @map("task_id")
  completed Boolean @default(false)
  completedAt DateTime? @map("completed_at")
  attempts Int @default(0)
  lastAttemptAt DateTime @map("last_attempt_at") @default(now())
  userAnswer String? @map("user_answer") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Tasks @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model UserLabProgress {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  labId Int @map("lab_id")
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  lastAccessed DateTime @updatedAt @map("last_accessed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab Labs @relation(fields: [labId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  GENERAL
  ALERT
  REMINDER
  PROMOTIONAL
  REWARDS
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  message String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  isRead Boolean @default(false) @map("is_read")
  isDeleted Boolean @default(false) @map("is_deleted")
  notificationType NotificationType @map("notification_type") @default(GENERAL)
  link String? @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReminderSettings {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  reminderTime DateTime @map("reminder_time")
  reminderTimeUtc DateTime @map("reminder_time_utc")
  timezone String @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  lastReminderSent DateTime? @map("last_reminder_sent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// TEMPLATE MANAGEMENT MODELS
// ============================================

enum TemplateCategory {
  MAIN
  AUTH
  PROFILE
  ISSUE
  DOMAIN
  ORGANIZATION
  PROJECT
  OTHER
}

model Template {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(255)
  path String @db.VarChar(500)
  category TemplateCategory @default(OTHER)
  description String? @db.Text
  hasSidenav Boolean @default(false) @map("has_sidenav")
  extendsBase Boolean @default(false) @map("extends_base")
  hasStyleTags Boolean @default(false) @map("has_style_tags")
  url String? @db.VarChar(500)
  viewCount Int @default(0) @map("view_count")
  modifiedAt DateTime @map("modified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template")
}

